{
  "openapi": "3.1.1",
  "info": {
    "title": "Remis.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7079"
    },
    {
      "url": "http://localhost:5170"
    }
  ],
  "paths": {
    "/api/Personas": {
      "get": {
        "tags": [
          "Personas"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Personas/{id}": {
      "get": {
        "tags": [
          "Personas"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Personas/dni/{dni}": {
      "get": {
        "tags": [
          "Personas"
        ],
        "parameters": [
          {
            "name": "dni",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Personas"
    }
  ]
}